# Copy to .env and set your own passwords; .env is not committed.
POSTGRES_PASSWORD=change-me
KEYSTONE_MONITOR_PASSWORD=change-me
REPLICATOR_PASSWORD=change-me
HOST_SSH_PASSWORD=change-me        # user keystone on pg17-primary/replica, SSH port 2222

# Extra addresses of the Docker host (netplan), one per server, all on port 5432.
PG15_IP=192.168.1.105
PG16_IP=192.168.1.106
PG17_PRIMARY_IP=192.168.1.107
PG17_REPLICA_IP=192.168.1.108
PG18_IP=192.168.1.109
